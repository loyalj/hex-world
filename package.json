{
  "name": "@loyalj/hex-world",
  "version": "0.1.1",
  "description": "Three.js hex grid library for strategy and exploration games — chunk-based rendering, terrain, water, roads, scatter, fog of war, pathfinding, and procedural generation.",
  "author": "Loyal Johnson <loyalj@gmail.com>",
  "license": "ISC",
  "keywords": [
    "hexagon",
    "hex",
    "hex-grid",
    "hex-map",
    "three",
    "threejs",
    "three.js",
    "strategy",
    "strategy-game",
    "rts",
    "game",
    "webgl",
    "procedural-generation",
    "pathfinding",
    "fog-of-war",
    "tilemap"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalj/hex-world.git"
  },
  "homepage": "https://github.com/loyalj/hex-world#readme",
  "bugs": {
    "url": "https://github.com/loyalj/hex-world/issues"
  },
  "main": "./dist/hex-world.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/hex-world.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "three": "^0.184.0",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  }
}
